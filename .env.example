# Copy to .env to override defaults used by docker-compose.yml.
# These are local-only demo credentials; change them before exposing anything.
MINIO_ROOT_USER=openlake
MINIO_ROOT_PASSWORD=openlake-secret
AWS_REGION=us-east-1
OPENLAKE_BUCKET=openlake

# Size of the generated historical dataset (the real Olist dataset has ~99k orders).
OPENLAKE_SCALE_ORDERS=100000

# Spark sizing — conservative defaults for a 16 GB laptop (Docker VM with ~8 GB).
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
OPENLAKE_DRIVER_MEMORY=2g
OPENLAKE_EXECUTOR_MEMORY=2g
OPENLAKE_EXECUTOR_CORES=2
OPENLAKE_SHUFFLE_PARTITIONS=8
# Run Spark inside the pipeline container instead of the cluster: local[*]
OPENLAKE_SPARK_MASTER=spark://spark-master:7077
